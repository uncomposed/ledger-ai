{
  "$id": "task.completed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "completed_by_actor_id", "produced"],
  "properties": {
    "task_id": { "type": "string", "format": "uuid" },
    "completed_by_actor_id": { "type": "string", "format": "uuid" },
    "completion_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["track"] },
          "track_id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "produced": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeset_ids"],
      "properties": {
        "answer_id": { "type": ["string", "null"], "format": "uuid" },
        "changeset_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    }
  }
}

