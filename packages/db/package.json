{
  "name": "@ledger/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "node -e \"process.exit(0)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "test:integration": "node --test --import tsx src/test/outbox-idempotency.test.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:ci": "node --import tsx prisma/seed/ci.ts",
    "db:verify": "node --import tsx src/verify.ts"
  },
  "dependencies": {
    "@ledger/events": "workspace:*",
    "@ledger/policy": "workspace:*",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
