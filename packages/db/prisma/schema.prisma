generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventOutbox {
  id            String    @id @default(uuid())
  entityId      String
  entity        Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  correlationId String
  eventType     String
  eventVersion  Int
  occurredAt    DateTime
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  publishError  String?
  claimedAt     DateTime?
  claimedBy     String?
  leaseUntil    DateTime?

  @@index([publishedAt])
  @@index([leaseUntil])
  @@index([correlationId])
  @@index([entityId, occurredAt])
}

model EventLog {
  id            String   @id @default(uuid())
  outboxId      String   @unique
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  correlationId String
  eventType     String
  eventVersion  Int
  occurredAt    DateTime
  payload       Json
  appendedAt    DateTime @default(now())

  @@index([entityId, occurredAt])
  @@index([correlationId])
}

enum TaskState {
  proposed
  ready
  in_progress
  completed
  blocked
  cancelled
}

enum ActorType {
  human
  ai
  system
}

model Actor {
  id        String    @id @default(uuid())
  type      ActorType @default(human)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships        Membership[]
  tasksCreated       Task[]       @relation("TaskCreatedBy")
  tasksUpdated       Task[]       @relation("TaskUpdatedBy")
  changeSetsProposed ChangeSet[]  @relation("ChangeSetProposedBy")
  changeSetsApproved ChangeSet[]  @relation("ChangeSetApprovedBy")
}

model Entity {
  id             String   @id @default(uuid())
  parentEntityId String?
  parent         Entity?  @relation("EntityParent", fields: [parentEntityId], references: [id])
  children       Entity[] @relation("EntityParent")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]
  tasks       Task[]
  changeSets  ChangeSet[]
  outbox      EventOutbox[]
  eventLog    EventLog[]

  @@index([parentEntityId])
}

enum MembershipRole {
  admin
  contributor
  accountable
}

model Membership {
  id        String         @id @default(uuid())
  entityId  String
  actorId   String
  role      MembershipRole
  version   Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  actor  Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([entityId, actorId])
  @@index([actorId])
  @@index([entityId, role])
}

model Task {
  id               String      @id @default(uuid())
  entityId         String
  entity           Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  type             String
  state            TaskState
  title            String
  version          Int         @default(0)
  createdByActorId String
  createdByActor   Actor       @relation("TaskCreatedBy", fields: [createdByActorId], references: [id], onDelete: Restrict)
  updatedByActorId String?
  updatedByActor   Actor?      @relation("TaskUpdatedBy", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  stateChangedAt   DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  changeSets       ChangeSet[]

  @@index([entityId, state])
}

enum ChangeSetState {
  draft
  pending_approval
  applied
  rejected
}

model ChangeSet {
  id                String         @id @default(uuid())
  entityId          String
  entity            Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  taskId            String
  task              Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  state             ChangeSetState
  version           Int            @default(0)
  baseType          String
  baseVersion       Int
  riskLevel         String
  patch             Json
  proposedByActorId String
  proposedByActor   Actor          @relation("ChangeSetProposedBy", fields: [proposedByActorId], references: [id], onDelete: Restrict)
  approvedByActorId String?
  approvedByActor   Actor?         @relation("ChangeSetApprovedBy", fields: [approvedByActorId], references: [id], onDelete: SetNull)
  stateChangedAt    DateTime       @default(now())
  appliedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([entityId, state])
  @@index([taskId, state])
}
