generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventOutbox {
  id            String    @id @default(uuid())
  entityId      String
  entity        Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  correlationId String
  eventType     String
  eventVersion  Int
  occurredAt    DateTime
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  publishError  String?
  claimedAt     DateTime?
  claimedBy     String?
  leaseUntil    DateTime?

  @@index([publishedAt])
  @@index([leaseUntil])
  @@index([correlationId])
  @@index([entityId, occurredAt])
}

model EventLog {
  id            String   @id @default(uuid())
  outboxId      String   @unique
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  correlationId String
  eventType     String
  eventVersion  Int
  occurredAt    DateTime
  payload       Json
  appendedAt    DateTime @default(now())

  @@index([entityId, occurredAt])
  @@index([correlationId])
}

enum TaskState {
  proposed
  ready
  in_progress
  completed
  blocked
  cancelled
}

enum ActorType {
  human
  ai
  system
}

model Actor {
  id        String    @id @default(uuid())
  type      ActorType @default(human)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships        Membership[]
  tasksCreated       Task[]       @relation("TaskCreatedBy")
  tasksUpdated       Task[]       @relation("TaskUpdatedBy")
  changeSetsProposed ChangeSet[]  @relation("ChangeSetProposedBy")
  changeSetsApproved ChangeSet[]  @relation("ChangeSetApprovedBy")
  tracksCreated      Track[]      @relation("TrackCreatedBy")
  answersAuthored    Answer[]     @relation("AnswerAnsweredBy")
}

model Entity {
  id             String   @id @default(uuid())
  parentEntityId String?
  parent         Entity?  @relation("EntityParent", fields: [parentEntityId], references: [id])
  children       Entity[] @relation("EntityParent")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]
  tasks       Task[]
  changeSets  ChangeSet[]
  tracks      Track[]
  lensRuns    LensRun[]
  questions   Question[]
  answers     Answer[]
  resources   Resource[]
  locations   Location[]
  inventory   InventoryItem[]
  outbox      EventOutbox[]
  eventLog    EventLog[]

  @@index([parentEntityId])
}

model Resource {
  id          String   @id @default(uuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind        String
  externalKey String?
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@unique([entityId, kind, externalKey])
  @@index([entityId, kind])
}

enum LocationKind {
  pantry
  fridge
  freezer
  counter
}

model Location {
  id        String       @id @default(uuid())
  entityId  String
  entity    Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind      LocationKind
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  items InventoryItem[]

  @@unique([entityId, kind, name])
  @@index([entityId, kind])
}

model InventoryItem {
  id         String   @id @default(uuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quantity   Decimal? @db.Decimal(18, 6)
  unit       String?
  version    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityId, resourceId, locationId])
  @@index([entityId, locationId])
  @@index([entityId, resourceId])
}

enum MembershipRole {
  admin
  contributor
  accountable
}

model Membership {
  id        String         @id @default(uuid())
  entityId  String
  actorId   String
  role      MembershipRole
  version   Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  actor  Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([entityId, actorId])
  @@index([actorId])
  @@index([entityId, role])
}

model Task {
  id               String      @id @default(uuid())
  entityId         String
  entity           Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  type             String
  state            TaskState
  title            String
  version          Int         @default(0)
  createdByActorId String
  createdByActor   Actor       @relation("TaskCreatedBy", fields: [createdByActorId], references: [id], onDelete: Restrict)
  updatedByActorId String?
  updatedByActor   Actor?      @relation("TaskUpdatedBy", fields: [updatedByActorId], references: [id], onDelete: SetNull)
  stateChangedAt   DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  changeSets       ChangeSet[]
  questions        Question[]

  @@index([entityId, state])
}

enum ChangeSetState {
  draft
  pending_approval
  applied
  rejected
}

model ChangeSet {
  id                String         @id @default(uuid())
  entityId          String
  entity            Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  taskId            String
  task              Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  state             ChangeSetState
  version           Int            @default(0)
  baseType          String
  baseVersion       Int
  riskLevel         String
  patch             Json
  proposedByActorId String
  proposedByActor   Actor          @relation("ChangeSetProposedBy", fields: [proposedByActorId], references: [id], onDelete: Restrict)
  approvedByActorId String?
  approvedByActor   Actor?         @relation("ChangeSetApprovedBy", fields: [approvedByActorId], references: [id], onDelete: SetNull)
  stateChangedAt    DateTime       @default(now())
  appliedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([entityId, state])
  @@index([taskId, state])
}

enum TrackKind {
  text
  image
}

enum TrackStatus {
  ingested
  processed
  failed
}

model Track {
  id               String      @id @default(uuid())
  entityId         String
  entity           Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind             TrackKind
  correlationId    String
  text             String?
  status           TrackStatus @default(ingested)
  createdByActorId String
  createdByActor   Actor       @relation("TrackCreatedBy", fields: [createdByActorId], references: [id], onDelete: Restrict)
  processedAt      DateTime?
  error            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  attachments TrackAttachment[]
  lensRuns    LensRun[]
  questions   Question[]

  @@index([entityId, createdAt])
  @@index([entityId, status])
  @@index([correlationId])
}

model TrackAttachment {
  id          String   @id @default(uuid())
  trackId     String
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  contentType String
  sizeBytes   Int
  sha256      String
  storageKey  String?
  createdAt   DateTime @default(now())

  @@index([trackId])
}

enum LensRunStatus {
  queued
  running
  succeeded
  failed
}

model LensRun {
  id         String        @id @default(uuid())
  entityId   String
  entity     Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lensKey    String
  status     LensRunStatus @default(queued)
  claimedAt  DateTime?
  claimedBy  String?
  leaseUntil DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([trackId, lensKey])
  @@index([entityId, status])
  @@index([leaseUntil])
}

enum QuestionStatus {
  open
  answered
  cancelled
}

model Question {
  id               String         @id @default(uuid())
  entityId         String
  entity           Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  trackId          String?
  track            Track?         @relation(fields: [trackId], references: [id], onDelete: SetNull)
  taskId           String?
  task             Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  status           QuestionStatus @default(open)
  version          Int            @default(0)
  prompt           String
  context          Json
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  answer Answer?

  @@index([entityId, status])
  @@index([trackId])
  @@index([taskId])
}

model Answer {
  id                String   @id @default(uuid())
  entityId           String
  entity             Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  questionId         String   @unique
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answeredByActorId  String
  answeredByActor    Actor    @relation("AnswerAnsweredBy", fields: [answeredByActorId], references: [id], onDelete: Restrict)
  answer             Json
  createdAt          DateTime @default(now())

  @@index([entityId, createdAt])
}
