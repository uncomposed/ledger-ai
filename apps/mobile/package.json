{
  "name": "@ledger/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "lint": "node -e \"process.exit(0)\"",
    "typecheck": "node -e \"process.exit(0)\"",
    "test": "node -e \"process.exit(0)\"",
    "dev": "expo start",
    "dev:clear": "expo start -c",
    "dev:localhost": "expo start --host localhost",
    "dev:localhost:clear": "expo start -c --host localhost",
    "dev:localhost:clear:8082": "expo start -c --host localhost --port 8082",
    "dev:localhost:clear:8082:debug": "EXPO_DEBUG=true EXPO_LOG_LEVEL=debug expo start -c --host localhost --port 8082",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.20.2",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.3",
    "expo-linking": "~7.0.5",
    "expo-secure-store": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9"
  }
}
